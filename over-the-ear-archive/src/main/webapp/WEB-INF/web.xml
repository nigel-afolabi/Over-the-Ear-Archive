<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

  <display-name>Over the Ear Archive</display-name>

  <context-param>
    <param-name>adminPassword</param-name>
    <param-value>overtheear-admin</param-value>
  </context-param>

  <servlet>
    <servlet-name>LatestServlet</servlet-name>
    <servlet-class>com.overtheear.controllers.LatestServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LatestServlet</servlet-name>
    <url-pattern>/latest</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AlbumController</servlet-name>
    <servlet-class>com.overtheear.controllers.AlbumController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AlbumController</servlet-name>
    <url-pattern>/album</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AdminServlet</servlet-name>
    <servlet-class>com.overtheear.controllers.AdminServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminServlet</servlet-name>
    <url-pattern>/admin</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

</web-app>
